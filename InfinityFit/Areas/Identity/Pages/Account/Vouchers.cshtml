@page
@model InfinityFit.Areas.Identity.Pages.Account.VouchersModel
@{
    ViewData["Title"] = "Vouchers";
}

<link rel="stylesheet" href="~/css/Vouchers.css" />

<style>
    .content-card {
        background: rgba(255, 255, 255, 0.0); /* complet transparent */
        box-shadow: none; /* elimină umbra */
        padding: 24px; /* păstrează padding-ul dacă vrei */
    }
</style>


<div class="vouchers-page">
    <div class="vouchers-hero">
        <h1 class="dynamic-title">🎁 Your Vouchers</h1>
    </div>

    <div class="vouchers-content">
        @if (!Model.UserVouchers.Any())
        {
            <p>You don't have any vouchers yet. Keep leveling up! 💪</p>
        }
        else
        {
            <div class="voucher-cards">
                @foreach (var voucher in Model.UserVouchers)
                {
                    <div class="voucher-card">
                        <h3>@voucher.Name</h3>
                        <p>@voucher.Description</p>
                        <p class="voucher-code">Code: <strong>@voucher.Code</strong></p>
                    </div>
                }
            </div>
        }
    </div>
</div>


@section Scripts {
    <script>
        // Dynamic typing effect for the title
        const title = document.querySelector('.dynamic-title');
        const text = "🎁 Welcome to your Vouchers!";
        let index = 0;
        title.textContent = '';

        function typeTitle() {
            if (index < text.length) {
                title.textContent += text[index];
                index++;
                setTimeout(typeTitle, 100);
            }
        }
        typeTitle();
    </script>
}
