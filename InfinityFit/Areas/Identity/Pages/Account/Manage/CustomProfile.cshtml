@page
@model InfinityFit.Areas.Identity.Pages.Account.Manage.CustomProfileModel

@{
    ViewData["Title"] = Model.CurrentUser?.UserName ?? "My Profile";
}
<h2>@Model.CurrentUser?.UserName</h2>



<!-- CSS -->
<link rel="stylesheet" href="~/css/Badge.css" />
<link rel="stylesheet" href="~/css/Post.css" />



@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success">@TempData["StatusMessage"]</div>
}
<p><strong style="color:blue;">Level:</strong> <span style="color:green;">@Model.CurrentUser.Level</span></p>

@{
    int userPoints = Model.CurrentUser.TotalPoints ?? 0;
}
@if (userPoints > 0)
{
    <p>
        <strong style="color:blue;">Points:</strong> 
        <span style="color:orange;">@userPoints</span>
    </p>
}
else
{
    <p>
        <strong style="color:blue;">Points:</strong> 
        <span style="color:orange; font-weight:bold;">You have to create a post to earn points</span>
    </p>
}

<a <a class="nav-link text-dark create-post" asp-page="/Posts/Create">➕ Create post</a>

<form method="post" class="mt-3">
    <div class="mb-3">
        <label asp-for="DailyDistanceGoal" class="form-label">Daily Distance Goal (km)</label>
        <input asp-for="DailyDistanceGoal" class="form-control" type="number" step="0.1" min="0" />
        <span asp-validation-for="DailyDistanceGoal" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update Distance Goal</button>
</form>

<hr />

<form method="post" asp-page-handler="GetLocation" id="locationForm">
    <input type="hidden" id="Latitude" name="Latitude" />
    <input type="hidden" id="Longitude" name="Longitude" />

    <button type="button" id="getLocationBtn"
            style="
                background: linear-gradient(135deg, #ff7eb3, #ff758c, #ff8f70);
                border: none;
                padding: 12px 22px;
                font-size: 18px;
                font-weight: bold;
                color: white;
                border-radius: 12px;
                cursor: pointer;
                box-shadow: 0 4px 12px rgba(255, 99, 132, 0.4);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            "
            onmouseover="this.style.transform='scale(1.07)'; this.style.boxShadow='0 6px 16px rgba(255, 99, 132, 0.6)'"
            onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='0 4px 12px rgba(255, 99, 132, 0.4)'">
        📍 Get Location of the Day
    </button>
</form>

<p style="margin-top:20px;">
    <strong style="color: lightpink;">Your location of the day is:</strong>
    <span style="color: green; font-weight: bold;">@Model.LocationOfTheDay</span>
</p>
@if (Model.TouristAddress != null)
{
    <p>
        <strong style="color:purple;">Address:</strong>
        <span style="color:black; font-weight:bold;">
            @Model.TouristAddress
        </span>
    </p>
}
@if (Model.TouristLatitude != null && Model.TouristLongitude != null)
{
    <div id="map" style="height: 400px; margin-top: 20px; border-radius:10px;"></div>
}



@if (Model.UserBadges.Count == 0)
{
    <p>No badges yet.</p>
}
else
{
    <div class="badge-grid">
        @foreach (var ub in Model.UserBadges)
        {
            <div class="badge-card">
                <img src="@ub.Badge.Icon" alt="@ub.Badge.Name" />
                <h4>@ub.Badge.Name</h4>
                <p>@ub.Badge.Description</p>
                <small>Awarded: @ub.DateAwarded.ToShortDateString()</small>
            </div>
        }
    </div>
}

<p><strong style="color:blue;">Posts:</strong></p>

@if (!Model.Posts.Any())
{
    <p>No posts yet.</p>
}
else
{
    <div class="post-grid">
        @foreach (var post in Model.Posts)
        {
            <partial name="_PostCard" model="post" />
        }
    </div>
}


<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteModal" class="modal-overlay">
    <div class="modal-box">
        <h4>Delete Post?</h4>
        <p>Are you sure you want to delete this post?</p>

        <div class="modal-actions">
            <form method="post" asp-page-handler="DeletePost">
                <input type="hidden" id="deletePostId" name="postId" />
                <button type="submit" class="confirm-delete">Yes, delete</button>
            </form>

            <button class="cancel-delete" onclick="closeDeleteModal()">Cancel</button>
        </div>
    </div>
</div>




@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>


    <!-- AJAX PT ACTUALIZARE LIVE COMENTARII-->
    <script src="https://unpkg.com/htmx.org@1.9.3"></script>


    <partial name="_ValidationScriptsPartial" />

    <script>
        function openDeleteModal(postId) {
            document.getElementById("deletePostId").value = postId;
            document.getElementById("deleteModal").style.display = "flex";
        }

        function closeDeleteModal() {
            document.getElementById("deleteModal").style.display = "none";
        }
    </script>
}
