@page "{username}"
@model InfinityFit.Pages.Profile.IndexModel

<h2>@Model.ProfileUser.UserName</h2>

<p>
    <strong>Level:</strong> @Model.ProfileUser.Level
</p>


<!-- CSS -->
<link rel="stylesheet" href="~/css/Badge.css" />
<link rel="stylesheet" href="~/css/Post.css" />


<p><strong style="color:blue;">Badges:</strong></p>

@if (Model.UserBadges.Count == 0)
{
    <p>No badges yet.</p>
}
else
{
    <div class="badge-grid">
        @foreach (var ub in Model.UserBadges)
        {
            <div class="badge-card">
                <img src="@ub.Badge.Icon" alt="@ub.Badge.Name" />
                <h4>@ub.Badge.Name</h4>
                <p>@ub.Badge.Description</p>
                <small>Awarded: @ub.DateAwarded.ToShortDateString()</small>
            </div>
        }
    </div>
}


<p><strong style="color:blue;">Posts:</strong></p>

@if (!Model.Posts.Any())
{
    <p>No posts yet.</p>
}
else
{
    <div class="post-grid">
        @foreach (var post in Model.Posts)
        {
            <partial name="_PostCard" model="post" />
        }
    </div>
}




<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteModal" class="modal-overlay">
    <div class="modal-box">
        <h4>Delete Post?</h4>
        <p>Are you sure you want to delete this post?</p>

        <div class="modal-actions">
            <form method="post" asp-page-handler="DeletePost">
                <input type="hidden" id="deletePostId" name="postId" />
                <button type="submit" class="confirm-delete">Yes, delete</button>
            </form>

            <button class="cancel-delete" onclick="closeDeleteModal()">Cancel</button>
        </div>
    </div>
</div>


@section Scripts{
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <!-- AJAX PT ACTUALIZARE LIVE COMENTARII-->
    <script src="https://unpkg.com/htmx.org@1.9.3"></script>


    <partial name="_ValidationScriptsPartial" />

    <script>
        function openDeleteModal(postId) {
            document.getElementById("deletePostId").value = postId;
            document.getElementById("deleteModal").style.display = "flex";
        }

        function closeDeleteModal() {
            document.getElementById("deleteModal").style.display = "none";
        }
    </script>
}