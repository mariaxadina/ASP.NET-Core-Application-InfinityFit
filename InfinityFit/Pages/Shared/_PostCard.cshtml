@model InfinityFit.Models.Post

<div class="card mb-3 shadow-sm mx-auto" style="max-width: 500px;">
    <div class="card-header py-2 d-flex justify-content-between align-items-center">
        <a asp-page="/Account/Manage/CustomProfile"asp-route-userId="@Model.User.Id"class="small fw-bold text-decoration-none text-dark">@Model.User.UserName</a>
        <small class="text-muted">
            @Model.DatePosted.ToLocalTime().ToString("dd MMM HH:mm")
        </small>
    </div>

    <img src="@Model.ImagePath"
         class="card-img-top"
         style="max-height: 300px; object-fit: cover;" />

    <div class="card-body py-2">
        @if (!string.IsNullOrEmpty(Model.Title))
        {
            <h6 class="mb-1">@Model.Title</h6>
        }

        <p class="small mb-2 text-muted">
            @Model.Description
        </p>

        <div class="d-flex justify-content-between align-items-center">
            <small>
                <form method="post"
                      asp-page="/Feed"
                      asp-page-handler="Like"
                      asp-route-postId="@Model.Id"
                      class="d-inline">

                    <button type="submit"
                            class="btn btn-link p-0"
                            title="Like">
                        ❤️
                    </button>

                    @Model.Likes.Count
                </form>

                |
                <button type="button"
                        class="btn btn-link p-0"
                        data-bs-toggle="modal"
                        data-bs-target="#commentsModal-@Model.Id">
                    💬 @Model.Comments.Count
                </button>

                <partial name="_CommentsModal" model="Model" />
            </small>
        </div>
    </div>
</div>
