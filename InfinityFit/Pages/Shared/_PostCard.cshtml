@model InfinityFit.Models.Post

<div class="post-card">

    <!-- HEADER -->
    <div class="post-header">
        <span class="post-title">@Model.Title</span>

        @if (User.Identity.IsAuthenticated && User.Identity.Name == Model.User.UserName)
        {
            <button type="button"
                    class="delete-btn"
                    onclick="openDeleteModal('@Model.Id')">
                ✖
            </button>

        }

    </div>

    <!-- IMAGE -->
    <div class="post-image-wrapper">
        <img src="@Model.ImagePath"
             alt="Post image"
             class="post-image" />
    </div>

    <!-- DESCRIPTION -->
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="post-description">@Model.Description</p>
    }

    <!-- STATS -->
    <div class="post-stats">
        <!-- LIKE -->
        <form method="post"
              asp-page-handler="Like"
              asp-route-postId="@Model.Id"
              class="d-inline">

            <button hx-post="?handler=Like&postId=@Model.Id"
                    hx-target="#like-count-@Model.Id"
                    hx-swap="outerHTML">
                ❤️ <span id="like-count-@Model.Id">@Model.Likes.Count</span>
            </button>


        </form>



        <!-- COMMENTS -->
        <button type="button"
                class="btn btn-link p-0"
                data-bs-toggle="modal"
                data-bs-target="#commentsModal-@Model.Id">
            💬 @Model.Comments.Count
        </button>
    </div>

    <!-- DATE -->
    <div class="creation-date">
        @Model.DatePosted.ToString("g")
    </div>
</div>

<!-- MODAL COMENTARII -->
<partial name="_CommentsModal" model="Model" />
