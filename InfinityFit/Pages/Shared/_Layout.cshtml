<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InfinityFit</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" />
    <link rel="stylesheet" href="~/css/Post.css" />
    <link rel="stylesheet" href="~/css/Leaderboard.css" />
    <link rel="stylesheet" href="~/css/Map.css" />
    <link rel="stylesheet" href="~/css/ManageNav.css" />
    <link rel="stylesheet" href="~/InfinityFit.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.jpg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


    <script src="https://kit.fontawesome.com/c2bbd65096.js" crossorigin="anonymous"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark custom-navbar shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-page="/Index">
                    <img src="~/favicon.jpg" alt="InfinityFit" class="brand-logo" />
                    InfinityFit
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-expanded="false">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">
                                <i class="fa-solid fa-house"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Leaderboard">
                                <i class="fa-solid fa-trophy"></i> Leaderboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Map">
                                <i class="fa-solid fa-earth-americas"></i> Map
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Arcade">
                                <i class="fa-solid fa-dice"></i> Arcade
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Feed">
                                <i class="fa-regular fa-newspaper"></i> Feed
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link daily-location" asp-area="Identity" asp-page="/Account/Location_of_the_Day">
                                📍 Location of the Day
                            </a>
                        </li>

                    </ul>
                    
                    <a class="btn btn-create-post me-3" asp-page="/Posts/Create">
                        ➕ Create Post
                    </a>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3 content-card">
            @RenderBody()
        </main>
    </div>


    <footer class="custom-footer">
        <div class="container text-center">
            <p class="mb-1">&copy; 2026 <strong>InfinityFit</strong></p>
            <p class="small mb-1">
                Collaborators: Maria Topliceanu, Stefan Bichel & Alexandru Boborica
            </p>
            <a asp-page="/Privacy" class="footer-link">Privacy Policy</a>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>