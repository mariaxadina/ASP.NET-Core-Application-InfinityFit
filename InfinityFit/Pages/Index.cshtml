@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<link rel="stylesheet" href="~/css/home.css" />


<div class="hero">
    <div class="hero-content">
        <h1>Welcome to <span>InfinityFit</span></h1>
        <p>Move. Explore. Achieve.</p>
    </div>
</div>

<section class="mission">
    <h2>Our Mission</h2>
    <p>
        We promote tourism through movement and motivation.
        Set your goal, start visiting landmarks today, and turn every step into progress.
    </p>
    <p>
        We guide you to exciting locations, challenge you to exercise as you move,
        and let you upload your achievements as photos.
    </p>
    <p>
        Curious about your gains?
        Collect badges, track your progress, and get rewarded with vouchers
        as we promote your journey.
    </p>
</section>
