@page
@model InfinityFit.Pages.FeedModel

<link rel="stylesheet" href="~/css/Feed.css" />
<div class="feed-page">
    <h2 class="feed-title">Feed</h2>

    @if (!Model.Posts.Any())
    {
        <p>Nu există postări.</p>
    }
    else
    {
        foreach (var post in Model.Posts)
        {
            <div class="card mb-3 shadow-sm mx-auto" style="max-width: 500px;">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <a asp-page="/Profile/Index"
                       asp-route-username="@post.User.UserName"
                       class="small fw-bold text-decoration-none">
                        @post.User.UserName
                    </a>

                    <small class="text-muted">
                        @post.DatePosted.ToLocalTime().ToString("dd MMM HH:mm")
                    </small>
                </div>

                <img src="@post.ImagePath"
                     class="card-img-top"
                     style="max-height: 300px; object-fit: cover;" />

                <div class="card-body py-2">
                    @if (!string.IsNullOrEmpty(post.Title))
                    {
                        <h6 class="mb-1">@post.Title</h6>
                    }

                    <p class="small mb-2 text-muted">
                        @post.Description
                    </p>

                    <div class="d-flex justify-content-between align-items-center">
                        <small>
                            <form method="post"
                                  asp-page-handler="Like"
                                  asp-route-postId="@post.Id"
                                  class="d-inline">

                                <button hx-post="?handler=Like&postId=@post.Id"
                                        hx-target="#like-count-@post.Id"
                                        hx-swap="outerHTML">
                                    ❤️ <span id="like-count-@post.Id">@post.Likes.Count</span>
                                </button>

                            </form>

                            |
                            <button type="button"
                                    class="btn btn-link p-0"
                                    data-bs-toggle="modal"
                                    data-bs-target="#commentsModal-@post.Id">
                                💬 @post.Comments.Count
                            </button>

                            

                        </small>
                    </div>
                </div>
            </div>
            <partial name="_CommentsModal" model="post" />
        }
    }
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div id="commentToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-danger text-white">
                <strong class="me-auto">Error</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
           <div class="toast-body">
                @TempData["CommentError"]
            </div>
        </div>
    </div>
</div>




@section Scripts {
    <!-- AJAX PT ACTUALIZARE LIVE COMENTARII-->
    <script src="https://unpkg.com/htmx.org@1.9.3"></script>



    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var toastEl = document.getElementById('commentToast');
            if (toastEl && toastEl.querySelector('.toast-body').textContent.trim() !== '') {
                var toast = new bootstrap.Toast(toastEl, { delay: 5000 });
                toast.show();
            }
        });
    </script>
}
