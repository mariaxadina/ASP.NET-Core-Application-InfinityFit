@page
@model LeaderboardModel

<h2 class="mb-3">🏆 Leaderboard</h2>

<form method="get" class="mb-4">
    <select asp-for="Type" class="form-select w-auto" onchange="this.form.submit()">
        <option value="Popularity">🔥 Popularity</option>
        <option value="Activity">⚡ Activity</option>
    </select>
</form>

<p class="text-muted">
    Leaderboard based on
    @(Model.Type == LeaderboardType.Popularity
        ? "most popular users"
        : "most active users")
</p>

<table class="table table-bordered custom-leaderboard">
    <thead>
        <tr>
            <th>#</th>
            <th>User</th>
            <th>Engagement</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Entries.Count; i++)
        {
            var rank = i + 1;
            var rankClass = rank <= 3 ? $"rank-{rank}" : "";

            <tr class="@rankClass">
                <td class="text-center">@rank</td>
                <td class="username-cell">@Model.Entries[i].User.UserName</td>
                <td>@Model.Entries[i].Engagement</td>
            </tr>
        }
    </tbody>
</table>