@page
@model InfinityFit.Pages.Map.MapModel
@{
    ViewData["Title"] = "Map";
}


<style>
    .content-card {
        background: rgba(255, 255, 255, 0.0); /* complet transparent */
        box-shadow: none; /* elimină umbra */
        padding: 24px; /* păstrează padding-ul dacă vrei */
    }
</style>


<h2 style="text-align:center;">📸 Discover places with one click </h2>

<div id="map" style="height: 500px; margin-bottom:20px;"></div>

<h3 style="text-align:center;">Click on the map to view photos from that place</h3>
<div id="photosContainer" class="photos-grid"></div>



@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        var map = L.map('map').setView([45.9432, 24.9668], 6);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        let markersLayer = L.layerGroup().addTo(map);
        let clickMarker = null;

                map.on('click', async function (e) {
            const lat = e.latlng.lat;
            const lon = e.latlng.lng;

            markersLayer.clearLayers();

            if (clickMarker) {
                map.removeLayer(clickMarker);
            }

            clickMarker = L.marker([lat, lon]).addTo(map);

            // Fetch HTML partial
            const response = await fetch(`?handler=NearbyPhotos&lat=${lat}&lon=${lon}`);
            const html = await response.text();

            const container = document.getElementById("photosContainer");
            container.innerHTML = html;
        });


        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (pos) {
                map.setView([pos.coords.latitude, pos.coords.longitude], 13);
            });
        }
    </script>
}
