@page
@model InfinityFit.Pages.Map.MapModel
@{
    ViewData["Title"] = "Map";
}

<h2 style="text-align:center;">📸 Discover places with one click </h2>

<div id="map" style="height: 500px; margin-bottom:20px;"></div>

<h3 style="text-align:center;">Click on the map to view photos from that place</h3>
<div id="photosContainer" class="photos-grid"></div>

<style>
    .photos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 15px;
        padding: 10px;
    }

    .photo-card {
        border: 1px solid #ddd;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        background: white;
        text-align: center;
    }

        .photo-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .photo-card .info {
            padding: 8px;
            font-size: 14px;
        }
</style>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        var map = L.map('map').setView([45.9432, 24.9668], 6);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        let markersLayer = L.layerGroup().addTo(map);
        let clickMarker = null;

        map.on('click', async function (e) {
            const lat = e.latlng.lat;
            const lon = e.latlng.lng;

            markersLayer.clearLayers();

            if (clickMarker) {
                map.removeLayer(clickMarker);
            }

            clickMarker = L.marker([lat, lon]).addTo(map);

            const response = await fetch(`?handler=NearbyPhotos&lat=${lat}&lon=${lon}`);
            const photos = await response.json();

            const container = document.getElementById("photosContainer");
            container.innerHTML = "";

            if (photos.length === 0) {
                container.innerHTML = "<p>There are no posts from this location.</p>";
                return;
            }

            photos.forEach(p => {
                L.marker([p.latitude, p.longitude]).addTo(markersLayer);

                container.innerHTML += `
                    <div class="photo-card">
                        <img src="${p.imagePath}" />
                        <div class="info">
                            <strong>${p.title ?? ""}</strong><br/>
                            ❤️ ${p.likesCount}
                        </div>
                    </div>
                `;
            });
        });

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (pos) {
                map.setView([pos.coords.latitude, pos.coords.longitude], 13);
            });
        }
    </script>
}
